{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Forward Deployed Engineering boutique for deterministic AI systems.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.027,
          0.035,
          0.055
        ],
        "hex": "#07090e"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.322,
          0.706,
          0.992
        ],
        "hex": "#52b4fd"
      }
    },
    "tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.063,
          0.725,
          0.506
        ],
        "hex": "#10b981"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.055,
          0.063,
          0.09
        ],
        "hex": "#0e1017"
      }
    },
    "surface-hover": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.086,
          0.098,
          0.141
        ],
        "hex": "#161924"
      }
    },
    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.133,
          0.153,
          0.212
        ],
        "hex": "#222736"
      }
    },
    "text-secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.58,
          0.639,
          0.722
        ],
        "hex": "#94a3b8"
      }
    },
    "text-muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.443,
          0.502,
          0.588
        ],
        "hex": "#718096"
      }
    },
    "cyan-deep": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.075,
          0.357,
          0.631
        ],
        "hex": "#135ba1"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    },
    "xxl": {
      "$value": {
        "value": 48,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "full": {
      "$value": {
        "value": 9999,
        "unit": "px"
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Satoshi, Inter, sans-serif",
        "fontSize": {
          "value": 3,
          "unit": "rem"
        },
        "fontWeight": 900,
        "letterSpacing": {
          "value": -0.02,
          "unit": "em"
        }
      }
    },
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Satoshi, Inter, sans-serif",
        "fontSize": {
          "value": 2.25,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": -0.01,
          "unit": "em"
        }
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter, sans-serif",
        "fontSize": {
          "value": 1.5,
          "unit": "rem"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": -0.01,
          "unit": "em"
        }
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter, sans-serif",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter, sans-serif",
        "fontSize": {
          "value": 0.875,
          "unit": "rem"
        },
        "fontWeight": 500
      }
    },
    "mono": {
      "$type": "typography",
      "$value": {
        "fontFamily": "JetBrains Mono, monospace",
        "fontSize": {
          "value": 0.8125,
          "unit": "rem"
        },
        "fontWeight": 500
      }
    }
  }
}
